int main(void)
{
	int n;
	printf("请输入正方形矩阵的行列数：");
	scanf("%d", & n);
	int a[100][100];
	int max[100], min[100];
	int st = 1;
	for (int i = 0;i < n;i++)
	{
		for (int j = 0;j < n;j++)
		{
			printf("请输入第%d行第%d个巨人的身高：", i + 1, j + 1);
			scanf("%d", &a[i][j]);
		}
	}
	for (int i = 0;i < n;i++)
	{
		max[i] = 0;
		for (int j = 0;j < n;j++)
		{
			if (a[i][j] > max[i])
			{
				max[i] = a[i][j];
			}
		}
	}
	for (int j = 0;j < n;j++)
	{
		min[j] = 1000;
		for (int i = 0;i < n;i++)
		{
			if (a[i][j] < min[j])
			{
				min[j] = a[i][j];
			}
		}
	}
	for (int i = 0;i < n;i++)
	{
		for (int j = 0;j < n;j++)
		{
			if (a[i][j] == max[i] && a[i][j] == min[j])
			{
				printf("(%d,%d)\n", i, j);
				st = 0;
			}
		}
	}
	if (st)
	{
		printf("NONE");
	}
	return 0;
}
