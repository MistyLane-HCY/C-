#include<stdio.h>
int main(void)
{
  int a,b;
  scanf("%d %d",&a,&b);
  for(int i=a;i<=b;i++)
  {
    if(i<2)
    {
      continue;
    }
    int st=1;
    for(int j=2;j<i;j++)
    {
      if(i%j==0)
      {
        st=0;
        break;
      }
    }
    if(st==1)
    {
      printf("%d",i);
    }
  }
  return 0;
}
